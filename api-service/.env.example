# Salin menjadi .env lalu jalankan: npm run start:env
# Nilai default di bawah = setelan bawaan MAMP di macOS.
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=8889
DB_USER=root
DB_PASSWORD=root
DB_NAME=olshop_db
# Jika koneksi TCP ditolak, pakai socket MAMP (kosongkan DB_HOST/DB_PORT tidak perlu):
# DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock
RASA_URL=http://localhost:5005
# Opsional: jika diisi, semua endpoint /api/* wajib header "x-api-key" yang sama
# (set juga OLSHOP_API_KEY di environment Rasa/actions).
API_KEY=
